# ==========================================================
# Crypto Multi-Agent Trading System Configuration
# ==========================================================

# 1. Google Gemini API Key
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# Default LLM Provider: "gemini", "openai", "deepseek", or "mock"
DEFAULT_LLM_PROVIDER="gemini"

# ==========================================================
# CẤU HÌNH PHÂN TẦNG MODEL THEO BẢNG QUOTA CỦA BẠN:
# ==========================================================
# 🟢 NHÓM 1: ĐỘI CHUYÊN GIA PHÂN TÍCH (ANALYSTS)
# Cần RPM cao (15), RPD khủng (500) để chạy song song liên tục không lo cạn hạn mức:
# - "gemini-3.5-flash-lite" (Được khuyên dùng nhất: 15 RPM, 500 RPD)
# - "gemini-3.1-flash-lite" (15 RPM, 500 RPD)
# - "gemini-2.5-flash-lite" (10 RPM, 20 RPD)
MODEL_ANALYST="gemini-3.5-flash-lite"

# 🟣 NHÓM 2: CHIEF TRADER (CIO) & TRANH BIỆN (DEBATE ARENA)
# Cần khả năng lý luận, phản biện đối kháng và tổng hợp chiến lược sâu nhất (5 RPM, 20 RPD):
# - "gemini-3.8-flash"                 (Đỉnh nhất hiện nay trong dòng Flash)
# - "gemini-3.8-live-extended-thinking"(Chuyên sâu tư duy chuỗi suy luận)
# - "gemini-3.7-flash"                 (Rất mạnh)
# - "gemini-3.6-flash"                 (Cân bằng)
# - "gemini-3.5-flash"                 (Ổn định)
# - "gemini-3-flash"
MODEL_REASONING="gemini-3.8-flash"

# 2. Market Data & Exchange
DEFAULT_EXCHANGE="binance"
DEFAULT_SYMBOL="BTC/USDT"
DEFAULT_TIMEFRAME="15m"

# Optional Exchange Keys (Chỉ cần khi đặt lệnh thật trên sàn; Paper trading không cần)
EXCHANGE_API_KEY=""
EXCHANGE_SECRET_KEY=""
PAPER_TRADING=true

# 3. System & Server
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
DATABASE_PATH="crypto_agents.db"
